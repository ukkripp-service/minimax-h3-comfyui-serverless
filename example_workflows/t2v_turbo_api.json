{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "turbo_lora": {
    "class_type": "MiniMaxH3TurboLoRA",
    "inputs": {
      "model": ["unet", 0],
      "lora_name": "minimax_h3_turbo_v4_step600_ema.safetensors",
      "strength": 1.0,
      "low_vram": false
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}
  },
  "cond": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "prompt": "A cinematic shot of a corgi surfing a small wave at golden hour, spray glittering in the sunlight, slow motion, gentle upbeat acoustic guitar soundtrack, waves crashing softly.",
      "width": 1344,
      "height": 768,
      "length": 124
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 42}
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["turbo_lora", 0], "conditioning": ["cond", 0]}
  },
  "turbo_sampler": {
    "class_type": "MiniMaxH3TurboSampler",
    "inputs": {}
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["turbo_lora", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["turbo_sampler", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["cond", 1]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sample", 0], "vae": ["vae_video", 0]}
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["sample", 0], "vae": ["vae_audio", 0]}
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["decode_video", 0], "fps": 24, "audio": ["decode_audio", 0]}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "video/MiniMax_H3_Turbo",
      "format": "auto",
      "codec": "auto"
    }
  }
}
